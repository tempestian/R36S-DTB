#!/bin/bash
echo "[DEBUG SLEEP] called with arg: $1 at $(date)" >> /var/log/sleep_debug.log

case $1 in
   pre)
        echo $(cat /sys/devices/platform/backlight/backlight/backlight/brightness 2>/dev/null) > /var/local/cur_bright.state
        echo 0 > /sys/devices/platform/backlight/backlight/backlight/brightness 2>/dev/null
        esp=$(lsmod | grep esp8089 | awk '{print $1}')
        modprobe -r dwc2 2>/dev/null
        /usr/sbin/alsactl store -f /var/local/asound.state 2>/dev/null
        if [ -f "/usr/local/bin/quickmode.sh" ]; then
          touch /dev/shm/.JUSTWOKEUP
        fi
        if [ "$esp" = "esp8089" ]; then
                rmmod esp8089
                touch /home/ark/.config/esp8089exists
        fi
        ;;
   post)
        /bin/bash /boot/log_audio_state.sh "AFTER_WAKE_UP" 2>/dev/null || true
        echo $(cat /var/local/cur_bright.state 2>/dev/null) > /sys/devices/platform/backlight/backlight/backlight/brightness 2>/dev/null
        /usr/sbin/alsactl restore -f /var/local/asound.state 2>/dev/null
        modprobe -r dwc2 2>/dev/null
        modprobe -i dwc2 2>/dev/null
        sleep 2
        systemctl is-active --quiet killer_daemon && sudo systemctl restart killer_daemon
        systemctl is-active --quiet batt_led.service && sudo systemctl restart batt_led
        if [ -f "/home/ark/.config/esp8089exists" ]; then
                modprobe -i esp8089
                rm /home/ark/.config/esp8089exists
        fi
        ;;
esac
